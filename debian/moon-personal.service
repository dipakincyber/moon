[Unit]
Description=Moon personal companion daemon
After=local-fs.target

[Service]
Type=simple
User=moon
Group=moon
Environment=MOON_HOME=/var/lib/moon
ExecStart=/usr/bin/moon daemon
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/moon

[Install]
WantedBy=multi-user.target